# ============================================================
# Plantilla de credenciales para deploy_test_server.sh
# Copia este archivo a `.deploy.env` y rellena tus valores:
#   cp .deploy.env.example .deploy.env
# ⚠️ `.deploy.env` está en .gitignore (no subirlo a git).
# ============================================================

# Host y usuario SSH del servidor de pruebas
DEPLOY_HOST=10.118.67.55
DEPLOY_USER=usr_admin

# Contraseña SSH del usuario (entre comillas simples si lleva $, %, etc.)
DEPLOY_SSH_PASS='TU_CONTRASENA_AQUI'

# Puerto público y directorio de la app en el servidor
DEPLOY_PORT=3005
DEPLOY_APP_DIR=/home/usr_admin/centro_renovaciones
