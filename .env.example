# ============================================
# Centro de Renovaciones - Variables de entorno
# Este archivo es SOLO referencia: el proyecto no
# carga archivos .env (no usa dotenv). Define estas
# variables directamente en tu sistema u hosting.
# ============================================

# Puerto en el que escucha el servidor
PORT=3001

# Secreto para firmar los tokens JWT (OBLIGATORIO en producción).
# Genera uno seguro con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Claves VAPID para notificaciones push (OPCIONAL).
# Si no se definen, el servidor las genera automáticamente y las guarda
# en la base de datos. Genera un par con:
#   node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(k)"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu@email.com

# ------------------------------------------------------------------
# Notas:
# - Las credenciales de SMTP (email), Twilio (SMS) y Telegram (bot) NO
#   van aquí: se configuran desde la interfaz en "Configurar alertas"
#   y se guardan en la base de datos local.
# - En Railway, la base de datos (server/data/) debe persistir en un
#   volumen montado en /app/server/data (ver README).
# ------------------------------------------------------------------
